# -------------------------------------------------------
# Recipe Finder – Environment Variables Template
# -------------------------------------------------------
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to source control.
# -------------------------------------------------------

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/recipefinder?retryWrites=true&w=majority

# Name of the MongoDB database
DB_NAME=recipefinder

# HTTP port the Express server listens on
PORT=5000
